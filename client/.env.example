NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional; defaults to the pinned date in sanity/env.ts
NEXT_PUBLIC_SANITY_API_VERSION=
# Server-only. Same value as the Sanity webhook's "Authorization: Bearer <secret>" header.
SANITY_REVALIDATE_SECRET=
# Public site origin, e.g. https://example.com (used by sitemap.xml / robots.txt)
NEXT_PUBLIC_SITE_URL=
# Formspree form URL for the home contact form (https://formspree.io/f/<id>). Unset = no form, social links only.
FORMSPREE_ENDPOINT=
# LOCAL ONLY. Viewer token + flag: the home timeline shows unpublished drafts (TODO fields hidden).
SANITY_READ_TOKEN=
SANITY_PREVIEW_DRAFTS=
